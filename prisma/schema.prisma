// 폴렘 (polem.org) — v2 schema
// 쟁점별 찬반 근거 아카이브 + 익명 투표 + 분포 결과.
// 로그인 없음(익명 쿠키 투표). 이전 토론 플랫폼 스키마는 git 히스토리 참조.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  SOCIETY // 사회쟁점 (사형제·기본소득·정년연장…)
  MONEY   // 돈·경제 (전세 vs 월세, 저축 vs 투자…)
  WORK    // 직장·커리어 (워라밸 vs 연봉…)
  LOVE    // 연애·관계
  LIFE    // 일상·소비
}

enum IssueStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Issue {
  id       String   @id @default(cuid())
  slug     String   @unique
  title    String // SEO 제목: "사형제 폐지, 찬성 vs 반대 근거 정리"
  question String // 투표 질문: "사형제, 유지해야 할까?"
  summary  String? // 한 줄 요약 (카드·메타 description)
  body     String? // 배경 설명 (검색 유입용 본문, 마크다운)

  category Category

  // 양측 라벨 — 사회쟁점은 찬성/반대, 밸런스는 자유 (전세 / 월세)
  proLabel String @default("찬성")
  conLabel String @default("반대")

  proArgs   Json // string[] 찬성(A) 측 근거
  conArgs   Json // string[] 반대(B) 측 근거
  aiBalance String? // 균형 요약 (양측 핵심을 중립 톤으로 한 문단)

  proVotes  Int @default(0)
  conVotes  Int @default(0)
  viewCount Int @default(0)

  status IssueStatus @default(PUBLISHED)
  tags   String[]    @default([])

  createdAt   DateTime @default(now())
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  votes Vote[]

  @@index([category, publishedAt])
  @@index([status, publishedAt])
}

model Vote {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  side      String // "PRO" | "CON"
  voterHash String // 익명 쿠키 기반 해시 (중복 방지, 개인식별 아님)
  createdAt DateTime @default(now())

  @@unique([issueId, voterHash])
  @@index([issueId])
}
